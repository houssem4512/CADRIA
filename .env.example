# ---------------------------------------------------------------------------
# Backend Django
# ---------------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-with-a-long-random-string
DJANGO_DEBUG=True

# Runtime des agents — LOCAL exécute les moteurs embarqués, HTTP appelle le
# service autonome (python -m orchestration.runtime_server).
AGENT_RUNTIME_ENABLED=True
AGENT_RUNTIME_MODE=LOCAL
ORCHESTRATOR=CadriaRuntime
SCOPING_AGENT_URL=
OPS_AGENT_URL=
RISK_AGENT_URL=

# ---------------------------------------------------------------------------
# Frontend Vite
# ---------------------------------------------------------------------------
VITE_API_URL=http://127.0.0.1:8000
